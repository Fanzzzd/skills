#!/usr/bin/env bash
# Wrapper: run aigc_detect.py with $AIGC_PY, else the venv at $DEAI_VENV (~/.cache/deai/venv).
HERE="$(cd "$(dirname "$0")" && pwd)"
VENV="${DEAI_VENV:-$HOME/.cache/deai/venv}"
PY="${AIGC_PY:-$VENV/bin/python}"
if [ ! -x "$PY" ]; then
  echo "No detector Python. Set AIGC_PY to a venv with torch+transformers, or:" >&2
  echo "  uv venv $VENV --python 3.12" >&2
  echo "  uv pip install --python $VENV/bin/python torch transformers accelerate huggingface_hub" >&2
  echo "Then fetch the weights once: AIGC_ONLINE=1 $0 FILE" >&2
  exit 2
fi
exec "$PY" "$HERE/aigc_detect.py" "$@"
